# Server-side Supabase connection. Never expose a database password or service-role key.
DATABASE_URL=postgresql://cloudexify_runtime:REPLACE_ME@YOUR_POOLER_HOST:6543/postgres?sslmode=require
DB_POOL_MAX=1
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app

# Supabase Auth project configuration.
# The publishable/anon key is a public client key; never use the service_role/secret key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy projects may use SUPABASE_ANON_KEY instead of SUPABASE_PUBLISHABLE_KEY.
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional legacy OIDC fallback; Supabase Auth is preferred when configured.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
