# Supabase Postgres Transaction Pooler URL (server-side only).
# Get it from Supabase Dashboard -> Connect -> Transaction pooler.
# Add sslmode=require and URL-encode reserved characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Keep one application-side connection per Vercel serverless function instance.
DB_POOL_MAX=1

# Exact browser origins. Include the Vercel production URL and any custom domain.
# Comma-separated; no trailing slash; do not use *.
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app,https://YOUR-CUSTOM-DOMAIN

# Required for authenticated dashboard/API user routes.
# Obtain these from the OIDC provider configured for Cloudexify.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
